# ==========================================
# enCounter Git line-ending configuration
# ==========================================

# Default text files use LF in the repository.
# This keeps source files consistent across
# Windows and Linux.
* text=auto eol=lf

# ==========================================
# Windows scripts
# ==========================================

*.bat text eol=crlf
*.cmd text eol=crlf

# ==========================================
# Linux / Unix scripts
# ==========================================

*.sh text eol=lf

# ==========================================
# Source code
# ==========================================

*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# ==========================================
# Binary files
# ==========================================

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary